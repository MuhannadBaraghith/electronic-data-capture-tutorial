<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Data Summary</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Patient Data Summary</h1>
        <h2>Record has been added successfully</h2>
        <div class="data-display">
            <p><strong>Patient PID:</strong> <%= patientId %></p>
            <p><strong>Smoking History:</strong> <%= smokingHistory %></p>
            <p><strong>Drinking History:</strong> <%= drinkingHistory %></p>
            <p><strong>Height:</strong> <%= height %> cm</p>
            <p><strong>Weight:</strong> <%= weight %> kg</p>
            <p><strong>BMI:</strong> <%= bmi %></p>
            <p><strong>Medical Conditions:</strong> <%= medicalConditions %></p>
        </div>
        <div>
            <a href="/" class="button">Back to Form</a>
        </div>
    </div>
</body>
</html> 